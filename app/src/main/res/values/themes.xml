<resources>

    <style name="Theme.PixelAutoDrawer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold_dark</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:statusBarColor">#0D0B1E</item>
        <item name="android:windowBackground">#0D0B1E</item>
    </style>

    <style name="GoldButton">
        <item name="android:background">@drawable/btn_gold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="RedButton" parent="GoldButton">
        <item name="android:background">@drawable/btn_red</item>
        <item name="android:textColor">@color/light</item>
    </style>

</resources>
