<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✦ ลากเพื่อย้าย ✦"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClose"
            style="@style/RedButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/light"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSetTopLeft"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="📍 ตั้งมุมซ้ายบน" />

    <Button
        android:id="@+id/btnSetBottomRight"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="📍 ตั้งมุมขวาล่าง" />

    <Button
        android:id="@+id/btnSetPalette"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🎨 ตั้งตำแหน่งถาดสี" />

    <Button
        android:id="@+id/btnGhost"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="👻 แสดงภาพซ้อนทับ" />

    <Button
        android:id="@+id/btnSpeed"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="⚡ ความเร็ว" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            style="@style/GoldButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ เริ่มวาด" />

        <Button
            android:id="@+id/btnStop"
            style="@style/RedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="■ หยุด" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/gold" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="วาดแล้ว 0%"
        android:textColor="@color/gold"
        android:textStyle="bold" />
</LinearLayout>
