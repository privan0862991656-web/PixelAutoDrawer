<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✦ ลาก ✦"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMin"
            style="@style/GoldButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="–"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnClose"
            style="@style/RedButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/light"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnSetTopLeft"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="📍 ตั้งมุมซ้ายบน"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSetBottomRight"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="📍 ตั้งมุมขวาล่าง"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSetPalette"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="🎨 ตั้งตำแหน่งถาดสี"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnGhost"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="👻 แสดงภาพซ้อนทับ"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSpeed"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="⚡ ความเร็ว"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            style="@style/GoldButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="▶ เริ่มวาด"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStop"
            style="@style/RedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="■ หยุด"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/gold" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="วาดแล้ว 0%"
        android:textColor="@color/gold"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
